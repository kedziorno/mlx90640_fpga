      <spirit:componentInstance>
         <spirit:instanceName>dualmem_temperature</spirit:instanceName>
         <spirit:componentRef spirit:vendor="xilinx.com" spirit:library="ip" spirit:name="blk_mem_gen" spirit:version="7.3" />
